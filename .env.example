# Base URL de transport-api (incluye el prefijo /api/v1). Es la API de produccion.
# EAS Build no recibe este archivo (.env esta en .gitignore): para los builds
# los mismos valores viven en el bloque `env` de cada perfil de eas.json.
EXPO_PUBLIC_API_URL=https://api.larutard.com.do/api/v1
# Origen de Socket.IO (sin path). Si falta, se usa el origen de EXPO_PUBLIC_API_URL
EXPO_PUBLIC_SOCKET_URL=https://api.larutard.com.do
# Claves de Google Maps SDK, RESTRINGIDAS por plataforma en Google Cloud:
#   Android: package do.com.flypack.rutardcliente + SHA-1/SHA-256 de EAS
#   iOS: bundle id do.com.flypack.rutardcliente
# Places, geocoding y rutas los resuelve la API; estas claves solo pintan el mapa.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
